    "global_motion_layer": {
      "source_line": "1889-1910",
      "rule": "Element.prototype.animate is wrapped. If options is an object, options.pp !== false, keyframes is an array of length >= 2, iterations is null/1 and duration > 1: when any keyframe property is in MOVE_PROPS the call runs at duration 540 with easing PP.MOVE; else when all properties are in FADE_PROPS it runs at 200 with PP.FADE. Keyframe-level easing keys are stripped in both cases. Delay, fill, composite, offsets are kept. Other calls are untouched.",
      "MOVE_PROPS": ["translate", "transform", "scale", "rotate", "top", "left", "right", "bottom", "width", "height", "clipPath", "borderRadius", "strokeDashoffset", "letterSpacing", "--spin"],
      "FADE_PROPS": ["opacity", "filter", "color", "backgroundColor"],
      "note": "Consequence: most authored durations/springs in the JS are NOT what runs. animations.md lists authored and effective timing side by side. spec/index.html (L427-430) confirms its timings are the effective ones."
    }
  },
